{
  "name": "decimen-optical-transfer",
  "private": true,
  "version": "0.4.0",
  "license": "AGPL-3.0-or-later",
  "description": "Offline file and text transfer using fountain-coded animated QR codes — screen to camera, no network.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "serve": "npm run build && vite preview",
    "demo": "vite --mode demo",
    "diagnostics": "vite --mode diagnostics",
    "benchmark": "vite --mode benchmark",
    "build": "tsc && tsc -p tsconfig.node.json && vite build",
    "build:standalone": "node -e \"require('node:fs').rmSync('dist-standalone',{recursive:true,force:true})\" && tsc && vite build --mode standalone-send && vite build --mode standalone-receive",
    "build:all": "npm run build && npm run build:standalone",
    "preview": "vite preview",
    "icons": "node --import tsx build/make-icons.ts",
    "benchmark:promote": "node --import tsx build/benchmarks.ts promote",
    "benchmark:readme": "node --import tsx build/benchmarks.ts readme",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "qrcode": "^1.5.4",
    "tsx": "4.20.6",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "overrides": {
    "workbox-build": {
      "glob": "^13.0.0"
    }
  }
}
